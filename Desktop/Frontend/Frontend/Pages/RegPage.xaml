<Page x:Class="Frontend.Pages.RegPage"
      KeepAlive="False"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Frontend.Pages"
      mc:Ignorable="d" 
      Title="RegPage"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

    <Grid Background="#242424">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,10,0">
            <Button Content="↩" FontSize="20" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="backToLogin" Foreground="White"/>
            <TextBlock Text="Register" FontSize="30" HorizontalAlignment="Center" Foreground="White"/>
            <TextBlock Text="Name" FontSize="20" HorizontalAlignment="Left" Foreground="White"/>
            <TextBox x:Name="NameTB" FontSize="20" HorizontalAlignment="Stretch"/>
            <TextBlock Text="姓" FontSize="20" HorizontalAlignment="Left" Foreground="White"/>
            <TextBox x:Name="LNameTB" FontSize="20" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Email" FontSize="20" HorizontalAlignment="Left" Foreground="White"/>
            <TextBox x:Name="EmailTB" FontSize="20" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Password" FontSize="20" HorizontalAlignment="Left" Foreground="White"/>
            <PasswordBox x:Name="PasswordTB" FontSize="20" HorizontalAlignment="Stretch"/>
            <Button Content="Register" Background="#DE52FF" FontSize="20" Margin="0,10,0,0" Click="Register" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</Page>

<Page x:Class="Frontend.Pages.RememberPassword"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Frontend.Pages"
      mc:Ignorable="d" 
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Title="RememberPassword">

    <Grid Background="#2424">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="10,0,10,0">
            <Button x:Name="backBTN" Content="↩" HorizontalAlignment="Left" Foreground="White" Background="#2424" BorderThickness="0" Width="20" Click="BackLogin">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Text="Remember" FontSize="25" HorizontalAlignment="Center" Foreground="White"/>
            <TextBlock Text="Password" FontSize="25" HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock Text="Email" FontSize="15" HorizontalAlignment="Center" Foreground="White"/>
            <TextBox x:Name="EmailTB" FontSize="20" HorizontalAlignment="Stretch" Foreground="Black"/>
            <Button Content="Send mail" Background="#DE52FF" FontSize="15" Margin="0,10,0,0" Click="RememberPasswordF" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Grid>
</Page>

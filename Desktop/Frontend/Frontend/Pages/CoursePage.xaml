<Page x:Class="Frontend.Pages.CoursePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Frontend.Pages"
      mc:Ignorable="d" 
      Title="CoursePage"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

    <Grid Background="#2424">
        <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="10,0,10,0">
            <TextBlock Text="Courses" FontSize="30" HorizontalAlignment="Center" Foreground="White"/>
            <TextBox x:Name="courseCodeTB" Text="" FontSize="15" TextAlignment="Center" HorizontalAlignment="Stretch"/>
            <Button Content="Enroll Course" Background="#DE52FF" FontSize="15" Margin="0,5,0,5" Foreground="Black" BorderThickness="0" Click="Enroll">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
            <ListBox x:Name="CourseList" Background="#2424" BorderThickness="0" SelectionChanged="CourseChange"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#291B2B"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border" CornerRadius="4" Padding="2" Background="{TemplateBinding Background}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="#DE52FF"/>
                                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>

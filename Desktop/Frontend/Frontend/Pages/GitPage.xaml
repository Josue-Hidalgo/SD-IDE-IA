<Page x:Class="Frontend.Pages.GitPage"
      KeepAlive="True"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Frontend.Pages"
      mc:Ignorable="d"
      Title="GitPage"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch">

    <Page.Resources>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#191919"/>
            <Setter Property="BorderBrush" Value="#210036"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>

                                    <ToggleButton Grid.Column="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0">

                                        <TextBlock Text="▼"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True">

                                <Border Background="#191919"
                                BorderBrush="#210036"
                                BorderThickness="1"
                                CornerRadius="5">

                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>

                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#191919"/>
            <Setter Property="Padding" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="5"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#3A2A5A"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="#4B3570"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Background="#2424">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="Git" FontSize="20"
                   HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,6"/>

        <!-- Repo seleccionado -->
        <Border Grid.Row="1" Background="#191919" CornerRadius="5" Margin="8,0,8,6" Padding="6,4">
            <TextBlock x:Name="RepoPathTB" Text="No repo selected" Foreground="#AAAAAA"
                       FontSize="11" TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Rama actual -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,6">
            <TextBlock Text="Branch: " Foreground="White" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentBranchTB" Text="—" Foreground="#DE52FF"
                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Cambiar rama -->
        <Grid Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="BranchCombo" Grid.Column="0" Background="#191919"
                      Foreground="White" BorderBrush="#210036" Margin="0,0,4,0"
                      SelectionChanged="BranchCombo_SelectionChanged"/>
            <Button Grid.Column="1" Content="Checkout" Background="#444" Foreground="White"
                    BorderThickness="0" Padding="8,4" Click="CheckoutBranch">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Botones de operaciones -->
        <StackPanel Grid.Row="4" Orientation="Vertical" Margin="8,0,8,0" VerticalAlignment="Top">

            <!-- Pull -->
            <Button Content="⬇ Pull" Background="#2A2A2A" Foreground="White"
                    BorderThickness="0" Padding="0,10" Margin="0,0,0,6"
                    FontSize="13" Click="DoPull">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Commit -->
            <TextBox x:Name="CommitMsgTB" Background="#191919" Foreground="White"
                     BorderBrush="#444" Padding="6" Margin="0,0,0,4"
                     FontSize="12" Text="Commit message..."
                     GotFocus="CommitMsg_GotFocus" LostFocus="CommitMsg_LostFocus">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <Button Content="✔ Commit (stage all)" Background="#2A2A2A" Foreground="White"
                    BorderThickness="0" Padding="0,10" Margin="0,0,0,6"
                    FontSize="13" Click="DoCommit">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Push -->
            <Button Content="⬆ Push" Background="#DE52FF" Foreground="White"
                    BorderThickness="0" Padding="0,10" Margin="0,0,0,6"
                    FontSize="13" Click="DoPush">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="7"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Merge -->
            <TextBlock Text="Merge into current branch:" Foreground="#AAAAAA"
                       FontSize="11" Margin="0,4,0,2"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MergeBranchCombo" Grid.Column="0" Background="#191919"
                          Foreground="White" BorderBrush="#444" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="Merge" Background="#444" Foreground="White"
                        BorderThickness="0" Padding="8,4" Click="DoMerge">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Status log -->
        <Border Grid.Row="5" Background="#191919" CornerRadius="5" Margin="8,8,8,8" Padding="4">
            <TextBlock x:Name="StatusTB" Text="" Foreground="#AAAAAA"
                       FontSize="11" TextWrapping="Wrap" MaxHeight="60"/>
        </Border>
    </Grid>
</Page>
